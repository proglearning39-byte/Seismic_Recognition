import torch
import torch.nn as nn
import math

class PatchTSTSelfAttention(nn.Module):
    def __init__(self, d_model):
        super().__init__()
        self.k_proj = nn.Linear(d_model, d_model)
        self.v_proj = nn.Linear(d_model, d_model)
        self.q_proj = nn.Linear(d_model, d_model)
        self.out_proj = nn.Linear(d_model, d_model)

    def forward(self, x):
        q = self.q_proj(x)
        k = self.k_proj(x)
        v = self.v_proj(x)
        
        scores = torch.matmul(q, k.transpose(-2, -1)) / math.sqrt(q.size(-1))
        attn_weights = torch.softmax(scores, dim=-1)
        out = torch.matmul(attn_weights, v)
        return self.out_proj(out)


class NormSublayer(nn.Module):
    def __init__(self, d_model):
        super().__init__()
        self.batchnorm = nn.BatchNorm1d(d_model)

    def forward(self, x):
        x_t = x.transpose(1, 2)
        out = self.batchnorm(x_t)
        return out.transpose(1, 2)


class PatchTSTEncoderLayer(nn.Module):
    def __init__(self, d_model, d_ff, dropout=0.1):
        super().__init__()
        self.self_attn = PatchTSTSelfAttention(d_model)
        self.dropout_path1 = nn.Dropout(dropout)
        self.norm_sublayer1 = NormSublayer(d_model)

        self.ff = nn.Sequential(
            nn.Linear(d_model, d_ff),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(d_ff, d_model)
        )
        self.dropout_path3 = nn.Dropout(dropout)
        self.norm_sublayer3 = NormSublayer(d_model)

    def forward(self, x):
        attn_out = self.self_attn(x)
        x = x + self.dropout_path1(attn_out)
        x = self.norm_sublayer1(x)

        ff_out = self.ff(x)
        x = x + self.dropout_path3(ff_out)
        x = self.norm_sublayer3(x)
        return x


class PositionalEncoder(nn.Module):
    def __init__(self, d_model, max_len=5000):
        super().__init__()
        self.position_enc = nn.Parameter(torch.zeros(1, max_len, d_model))
        self.positional_dropout = nn.Dropout(0.1)

    def forward(self, x):
        seq_len = x.size(1)
        x = x + self.position_enc[:, :seq_len, :]
        return self.positional_dropout(x)


class PatchTSTEmbedder(nn.Module):
    def __init__(self, patch_len, d_model, max_len=5000):
        super().__init__()
        self.input_embedding = nn.Linear(patch_len, d_model)
        self.positional_encoder = PositionalEncoder(d_model, max_len)

    def forward(self, x):
        x = self.input_embedding(x)
        x = self.positional_encoder(x)
        return x


class PatchTSTEncoder(nn.Module):
    def __init__(self, patch_len, d_model, d_ff, num_layers=3):
        super().__init__()
        self.embedder = PatchTSTEmbedder(patch_len, d_model)
        self.layers = nn.ModuleList([
            PatchTSTEncoderLayer(d_model, d_ff) for _ in range(num_layers)
        ])

    def forward(self, x):
        x = self.embedder(x)
        for layer in self.layers:
            x = layer(x)
        return x


class Head(nn.Module):
    def __init__(self, in_features, out_features, dropout=0.1):
        super().__init__()
        self.flatten = nn.Flatten(start_dim=1)
        self.dropout = nn.Dropout(dropout)
        self.linear = nn.Linear(in_features, out_features)

    def forward(self, x):
        x = self.flatten(x)
        x = self.dropout(x)
        return self.linear(x)


class PatchTSTEEWRobust(nn.Module):
    """
    強健型地震即時預警 PatchTST 模型
    支援自動匹配 .pkl 權重的維度對齊機制
    """
    def __init__(self, patch_len=16, d_model=128, d_ff=256, num_layers=3, seq_len=1600, head_out_features=1):
        super().__init__()
        self.patch_len = patch_len
        self.num_patches = seq_len // patch_len
        head_in_features = self.num_patches * d_model # 修正為動態計算: 100 * 128 = 12800 或權重匹配值

        # 相容層 (對齊 data.pkl 中的鍵值)
        self.scaler = nn.Identity()
        self.patchifier = nn.Identity()
        self.masking = nn.Identity()

        self.encoder = PatchTSTEncoder(patch_len, d_model, d_ff, num_layers=num_layers)
        self.head = Head(head_in_features, head_out_features)

    def patchify(self, x):
        if x.dim() == 3:
            x = x.squeeze(1)
        B, L = x.shape
        num_patches = L // self.patch_len
        x = x[:, :num_patches * self.patch_len]
        x = x.view(B, num_patches, self.patch_len)
        return x

    def forward(self, x):
        x = self.patchify(x)
        x = self.encoder(x)
        out = self.head(x)
        return out
